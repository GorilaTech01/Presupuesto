# Copy to .env and fill in what you have. Every field is optional except
# where noted; missing optional fields simply reduce which sources/features
# are available (the system fails closed to NO_TRADE / ANALYSIS_INCOMPLETE
# rather than guessing).

# --- LLM synthesis layer (optional; narrative/explanation only, never the
# source of any number or decision) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Free official-source API keys ---
# FRED: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# EIA: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# --- Broker / execution safety (NEVER set these true in this version) ---
MT5_ENABLED=false
AUTO_EXECUTION=false

# --- Paper trading / journal ---
PAPER_TRADING=true

# --- Risk (see README for CONSERVATIVE/MODERATE/AGGRESSIVE_MAX profiles) ---
ACCOUNT_EQUITY=
RISK_PERCENT=0.005

# --- Locale ---
TIMEZONE=America/Costa_Rica
